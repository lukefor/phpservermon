{
	"name": "phpservermon/phpservermon",
	"description": "PHP Server Monitor",
	"license": "GPL-3.0-or-later",
	"homepage": "https://www.phpservermonitor.org",
	"require": {
		"php": ">=8.2",
		"ext-curl": "*",
		"ext-json": "*",
		"ext-pdo": "*",
		"ext-xml": "*",
		"phpmailer/phpmailer": "^7.2",
		"symfony/config": "^7.4",
		"symfony/dependency-injection": "^7.4",
		"symfony/event-dispatcher": "^7.4",
		"symfony/http-foundation": "^7.4",
		"symfony/filesystem": "^7.4",
		"php-pushover/php-pushover": "1.0.1.1",
		"twig/twig": "^3.31",
		"jaxl/jaxl": "3.1.0.1"
	},
	"repositories": [
		{
			"type": "path",
			"url": "lib/jaxl",
			"options": { "symlink": false }
		},
		{
			"type": "path",
			"url": "lib/php-pushover",
			"options": { "symlink": false }
		}
	],
	"config": {
		"platform": {
			"php": "8.2.0"
		},
		"sort-packages": true
	},
	"autoload": {
		"files": [
			"./src/includes/psmconfig.inc.php",
			"./src/includes/functions.inc.php"
		],
		"psr-4": {
			"psm\\": "src/psm/"
		}
	}
}
